# Kopieren nach n8n-agent.env und anpassen
COMPOSE_DIR=/opt/n8n                      # Ordner mit docker-compose.yml
SERVICE=n8n                               # Service-Name in der Compose-Datei
HEALTH_URL=http://localhost:5678/healthz
AUTO_UPDATE=true                          # false = nur überwachen
FAIL_THRESHOLD=2                          # Fehlchecks bis Auto-Neustart
BACKUP_DIR=/var/backups/n8n
BACKUP_KEEP=7
# Benachrichtigung (optional):
#NOTIFY_URL=https://ntfy.sh/mein-geheimes-topic
#NOTIFY_TELEGRAM_TOKEN=
#NOTIFY_TELEGRAM_CHAT=
